# Backend environment — copy to "backend/.env" for local development,
# or set the same variables in your hosting provider (Railway/Vercel).
# NEVER commit a filled-in version of this file. All secret values below
# are intentionally left empty.

# Server
PORT=5000
NODE_ENV=development

# JWT — REQUIRED. The server refuses to start without a secret of at
# least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase (used by backend/services/supabase.js)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Sheets service account (legacy integration in
# backend/services/googleSheets.js — only needed if that service is used)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=

# CORS — FRONTEND_URL is always part of the default allowlist.
# CORS_ORIGIN optionally overrides the whole allowlist with a
# comma-separated list of origins.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=
